# 复制为 config.env 后按需修改: cp config.env.example config.env
# install.sh / uninstall.sh / scripts/*.sh 都会读取它。

# ---------------------------------------------------------------- AWS
AWS_PROFILE=                     # 留空 = 用默认凭证 / 环境变量
AWS_REGION=us-west-2
AZ1=us-west-2b                   # 所有节点放在 AZ1 (必须有 WORKER_INSTANCE_TYPE 的供货)
AZ2=us-west-2c                   # EKS 控制面要求第 2 个 AZ, 不放节点

# ---------------------------------------------------------------- 集群 (Terraform 输入)
CLUSTER_NAME=daft-ray-static
WORKER_INSTANCE_TYPE=r8g.4xlarge # 机型: r7i/r8i/r8a/r8g/r9g (EBS) 或 r8gd/r8id/r9gd (本地 NVMe) 的 4xlarge
WORKER_COUNT=3
OBJECT_STORE_BYTES=68719476736   # 每个 worker 的 object store: 64 GiB; 80 GB 写 80000000000
# ---- 集群模式: static = 测试一 (固定 3 节点); elastic = 测试二 (Karpenter 弹性 + FSx for Lustre)
# 测试二的完整示例见 config.test2.env.example
CLUSTER_MODE=static
# 以下 4 项仅 CLUSTER_MODE=elastic 时生效
HEAD_INSTANCE_TYPE=r8g.8xlarge   # Ray head 专用节点 (固定 1 台)
ELASTIC_MAX_VCPUS=1024           # Karpenter NodePool 的 vCPU 上限 (成本护栏)
FSX_STORAGE_GIB=4800             # FSx 容量, 必须是 2400 的倍数; 测试二原始值 81600 约 $38/小时
KARPENTER_VERSION=1.15.0

# ---------------------------------------------------------------- S3 / 数据
# 桶名留空 = daft-ray-input-<账号ID>-<region> / daft-ray-output-<账号ID>-<region>
INPUT_BUCKET=
OUTPUT_BUCKET=
DATA_PREFIX=tpch-v2
DATA_SCALE_FACTORS="1 100"       # 要生成的 TPC-H 规模; SF1000 约 367 GB, 在 CodeBuild 上约 20 分钟; 需要时再加
GENERATE_REFERENCE=true          # 用 DuckDB 计算 Q1-Q22 参考结果 (tpch_bench 校验结果用)

# ---------------------------------------------------------------- 镜像 / 版本 (与测试一一致)
IMAGE_TAG=2.59.0-daft0.7.26-duckdb1.5.6
RAY_BASE_IMAGE_ARM=rayproject/ray:2.59.0-py311-aarch64
RAY_BASE_IMAGE_X86=rayproject/ray:2.59.0-py311
KUBERAY_CHART_VERSION=1.7.1
KPS_CHART_VERSION=92.10.1        # kube-prometheus-stack
GRAFANA_CHART_VERSION=10.5.15
GRAFANA_IMAGE_VERSION=12.3.1     # Docker Hub grafana/grafana; arm64 镜像 tag 12.3.1, x86 镜像 tag 12.3.1-amd64
