# 测试二 (弹性集群 + FSx for Lustre) 的配置示例
# 用法: cp config.test2.env.example config.env && ./install.sh
# 与 config.env.example 相同的变量含义见该文件; 这里只列测试二的取值。
AWS_PROFILE=
AWS_REGION=us-east-1
AZ1=us-east-1c                   # worker / head / FSx 都在此 AZ (FSx 是单 AZ 文件系统)
AZ2=us-east-1b                   # EKS 控制面要求第 2 个 AZ, 不放节点
CLUSTER_NAME=daft-ray-elastic
CLUSTER_MODE=elastic
WORKER_INSTANCE_TYPE=r8g.16xlarge  # Karpenter NodePool 使用的 worker 机型 (64 vCPU / 512 GiB)
HEAD_INSTANCE_TYPE=r8g.8xlarge
ELASTIC_MAX_VCPUS=1024             # 最多约 16 台 r8g.16xlarge
FSX_STORAGE_GIB=4800               # 约 $2.3/小时; 要对齐原测试写 81600 (约 $38/小时)
KARPENTER_VERSION=1.15.0
WORKER_COUNT=0                     # elastic 模式忽略, worker 随作业拉起
OBJECT_STORE_BYTES=0               # elastic 模式由机型自动推导 (内存的 50%)
INPUT_BUCKET=
OUTPUT_BUCKET=
DATA_PREFIX=tpch-v2
DATA_SCALE_FACTORS="100 300 500 1000"   # 先生成到 S3, 再由 install.sh 第 8 步复制到 FSx
GENERATE_REFERENCE=true
IMAGE_TAG=2.59.0-daft0.7.26-duckdb1.5.6
RAY_BASE_IMAGE_ARM=rayproject/ray:2.59.0-py311-aarch64
RAY_BASE_IMAGE_X86=rayproject/ray:2.59.0-py311
KUBERAY_CHART_VERSION=1.7.1
KPS_CHART_VERSION=92.10.1
GRAFANA_CHART_VERSION=10.5.15
GRAFANA_IMAGE_VERSION=12.3.1
